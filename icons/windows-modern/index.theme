[Icon Theme]
Name=windows-modern
Comment=A consolidated Windows 11-style icon theme for KDE Plasma
Inherits=breeze,breeze-dark,hicolor

FollowsColorScheme=true
KDE-Extensions=.svg
DisplayDepth=32

DesktopDefault=48
DesktopSizes=16,22,24,32,48,64
ToolbarDefault=22
ToolbarSizes=16,22,24,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,24,32,48
SmallDefault=16
SmallSizes=16,22,24,32,48
PanelDefault=48
PanelSizes=16,22,24,32,48,64
DialogDefault=48
DialogSizes=16,22,24,32,48,64

Directories=status,actions,apps,devices,places,mimetypes,categories,emblems,emotes,animations

# ============================================================
# Status icons (panel/tray - 16-24px)
# ============================================================
[status]
Context=Status
Type=Scalable
Size=22
MinSize=16
MaxSize=48

[actions]
Context=Actions
Type=Scalable
Size=22
MinSize=16
MaxSize=48

[apps]
Context=Applications
Type=Scalable
Size=48
MinSize=32
MaxSize=256

[devices]
Context=Devices
Type=Scalable
Size=48
MinSize=16
MaxSize=128

[places]
Context=Places
Type=Scalable
Size=48
MinSize=16
MaxSize=256

[mimetypes]
Context=MimeTypes
Type=Scalable
Size=48
MinSize=16
MaxSize=256

[categories]
Context=Categories
Type=Scalable
Size=48
MinSize=16
MaxSize=128

[emblems]
Context=Emblems
Type=Scalable
Size=16
MinSize=8
MaxSize=48

[emotes]
Context=Emotes
Type=Scalable
Size=22
MinSize=16
MaxSize=48

[animations]
Context=Animations
Type=Scalable
Size=22
MinSize=16
MaxSize=48
